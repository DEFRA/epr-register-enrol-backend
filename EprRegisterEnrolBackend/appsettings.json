{
  "ReExApi": {
    "BaseUrl": "",
    "UseStub": false
  },
  "TestOrganisations": {
    "Enabled": false
  },
  "Mongo": {
    "DatabaseUri": "mongodb://set-automatically-when-deployed/admin?authSource=$external&authMechanism=MONGODB-AWS",
    "DatabaseName": "epr-register-enrol-backend"
  },
  "CdpUploader": {
    "Url": "",
    "SamplingPlanBucket": "sampling-plans",
    "BesEvidenceBucket": "bes-evidence",
    "GenericFilesBucket": "file-uploads"
  },
  "App": {
    "BaseUrl": ""
  },
  "CaseWorking": {
    "Url": "",
    "UseStub": true
  },
  "AccreditationChanges": {
    "SubmitToCaseManagement": false
  },
  "CaseManagementAuth": {
    "ExpectedClientId": "epr-register-enrol-management-be"
  },
  "Migrations": {
    "Ra691AccreditationReferenceCorrection": {
      "Enabled": false,
      "Apply": false,
      "SpotCheckConfirmedBy": ""
    },
    "Ra764OrganisationNameCorrection": {
      "Enabled": false,
      "Apply": false,
      "SpotCheckConfirmedBy": ""
    },
    "Ra788DuplicateApplicationDeletion": {
      "Enabled": false,
      "Apply": false,
      "SpotCheckConfirmedBy": "",
      "ExpectedDeletions": null
    },
    "Ra697ChangeRequestItemBackfill": {
      "Enabled": false,
      "Apply": false
    }
  },
  "FeatureFlags": {
    "InYearChangesEnabled": false
  },
  "TestData": {
    "SeedOnStartup": false
  },
  "AccreditationApiMonitoring": {
    "Enabled": true,
    "InitialDelay": "00:00:30",
    "Interval": "1.00:00:00"
  },
  "ServiceClients": {
    "FirstAccreditationYear": 2027,
    "Clients": []
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "EprRegisterEnrolBackend.ServiceClientAccess": "Information",
        "EprRegisterEnrolBackend.AccreditationApi.UnservableAccreditationCheckService": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.AccreditationReferenceCorrectionMigration": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.OrganisationNameCorrectionMigration": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.DuplicateApplicationDeletionMigration": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.IsNewSiteAudit": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.IsNewSiteCorrectionMigration": "Information",
        "EprRegisterEnrolBackend.AccreditationApplication.Startup.LastYearsAccreditationBackfillMigration": "Information"
      }
    },
    "Using": ["EprRegisterEnrolBackend"],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "WriteTo": [
      {
        "Name": "SmoothBursts",
        "Args": {
          "linesPerSecond": 200,
          "burst": 50,
          "queueCapacity": 10000,
          "shutdownFlushTimeout": "00:00:05",
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "EprRegisterEnrolBackend.Utils.Logging.CdpEcsTextFormatter, EprRegisterEnrolBackend"
              }
            }
          ]
        }
      }
    ]
  }
}
