{
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017",
    "DatabaseName": "epr"
  },
  "CdpUploader": {
    "Url": "http://localhost:7337",
    "SamplingPlanBucket": "sampling-plans",
    "BesEvidenceBucket": "bes-evidence",
    "GenericFilesBucket": "file-uploads"
  },
  "App": {
    "BaseUrl": "http://localhost:5000"
  },
  "CaseWorking": {
    "Url": "http://localhost:8085",
    "UseStub": false
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
